using BackendModular.{{ module_name }}.Domain;
using BackendModular.{{ module_name }}.Infrastructure.Persistence;
using BackendModular.{{ module_name }}.Shared.Dtos;
using Gridify;

namespace BackendModular.{{ module_name }}.Features.{{ plural_entity_name }}.{{ action_name }};

public class {{ action_name }}Handler({{ module_name }}DbContext db)
{
    public async Task<Result<PagedResult<{{ entity_name }}Dto>>> HandleAsync(
        {{ action_name }}Query query,
        CancellationToken ct)
    {
        var mapper = new GridifyMapper<{{ entity_name }}>()
            .GenerateMappings();

        var result = await db.Set<{{ entity_name }}>()
            .ToPagedResultAsync<{{ entity_name }}, {{ entity_name }}Dto>(query, mapper, ct);
            
        return result;
    }
}
